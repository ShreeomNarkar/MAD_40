<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Examination"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Exam Name"
            app:boxStrokeColor="@color/primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExamName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Question Details" android:textStyle="bold" android:textColor="@color/accent"/>

                <EditText
                    android:id="@+id/etQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Type question here..."
                    android:background="@null"
                    android:minLines="2" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEE" android:layout_marginVertical="12dp"/>

                <EditText android:id="@+id/etOpt1" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Option A" android:background="@null"/>
                <EditText android:id="@+id/etOpt2" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Option B" android:background="@null"/>
                <EditText android:id="@+id/etOpt3" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Option C" android:background="@null"/>
                <EditText android:id="@+id/etOpt4" android:layout_width="match_parent" android:layout_height="45dp" android:hint="Option D" android:background="@null"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAddMore"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="+ SAVE &amp; ADD NEXT QUESTION"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/btnFinalSchedule"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="FINALIZE &amp; PUBLISH"
            android:backgroundTint="@color/primary"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>